<template>
  <div class="guide-page">
    <text class="guide-back" style="left: {{topButtonLeft}}px;width: {{topButtonWidth}}px;" @click="goBack">返回</text>
    <text class="guide-title" style="left: {{titleLeft}}px;width: {{titleWidth}}px;">使用说明</text>
    <list class="guide-list" style="left: {{cardLeft}}px;width: {{cardWidth}}px;height: {{guideListHeight}}px;">
      <list-item type="guide" for="{{guideItems}}" class="guide-item" style="height: {{$item.itemHeight}}px;">
        <div class="guide-card" style="width: {{cardWidth}}px;height: {{$item.cardHeight}}px;">
          <text class="guide-card-title" style="width: {{guideTextWidth}}px;">{{$item.title}}</text>
          <text class="guide-card-body" style="width: {{guideTextWidth}}px;height: {{$item.bodyHeight}}px;">{{$item.body}}</text>
        </div>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from "@system.router"
import device from "@system.device"
import { createScreenLayout } from "../../services/screenProfile.js"

const GUIDE_ITEMS = [
  {
    title: "1. 输入分子式",
    body: "分别点击两个输入框，输入想同时查询的两个分子式，例如 HCl 和 NaOH。"
  },
  {
    title: "2. 使用键盘",
    body: "元素键用于输入原子，123 用于输入原子数，荷用于输入正负电荷，组可快速输入常见基团。"
  },
  {
    title: "3. 查看结果",
    body: "按搜索后，会列出同时包含两个分子式的化学方程式。结果较多时可上下滑动或翻页。"
  },
  {
    title: "4. 编辑与删除",
    body: "编辑页点击回车保存，点击红色删除可一键清空当前输入框。"
  },
  {
    title: "注意",
    body: "请尽量输入标准分子式。数据库仍在完善，如有错误或缺漏，可在关于页联系反馈。"
  }
]

function estimateLines(text, charsPerLine) {
  return Math.max(1, Math.ceil((text || "").length / charsPerLine))
}

function buildGuideItems(cardWidth) {
  const charsPerLine = Math.max(12, Math.floor((cardWidth - 24) / 13))
  return GUIDE_ITEMS.map((item) => {
    const bodyLines = estimateLines(item.body, charsPerLine)
    const bodyHeight = bodyLines * 18
    const cardHeight = 44 + bodyHeight
    return Object.assign({}, item, {
      bodyHeight,
      cardHeight,
      itemHeight: cardHeight + 10
    })
  })
}

export default {
  private: {
    screenWidth: 212,
    screenHeight: 520,
    topButtonLeft: 66,
    topButtonWidth: 80,
    titleLeft: 46,
    titleWidth: 120,
    cardLeft: 12,
    cardWidth: 188,
    guideTextWidth: 164,
    guideListHeight: 370,
    guideItems: buildGuideItems(188)
  },

  onInit() {
    this.applyScreenLayout(createScreenLayout(this.screenWidth, this.screenHeight, "pill"))
    device.getInfo({
      success: (data) => {
        if (data) {
          this.applyScreenLayout(createScreenLayout(
            data.screenWidth || this.screenWidth,
            data.screenHeight || this.screenHeight,
            data.screenShape || ""
          ))
        }
      }
    })
  },

  applyScreenLayout(layout) {
    this.screenWidth = layout.screenWidth
    this.screenHeight = layout.screenHeight
    this.topButtonLeft = layout.topButtonLeft
    this.topButtonWidth = layout.topButtonWidth
    this.titleLeft = Math.floor((layout.screenWidth - 120) / 2)
    this.titleWidth = 120
    this.cardLeft = layout.cardLeft
    this.cardWidth = layout.cardWidth
    this.guideTextWidth = Math.max(136, layout.cardWidth - 24)
    this.guideListHeight = layout.guideListHeight
    this.guideItems = buildGuideItems(layout.cardWidth)
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.guide-page {
  width: 100%;
  height: 100%;
  background-color: #f4f7f5;
}

.guide-back {
  position: absolute;
  top: 14px;
  height: 44px;
  color: #ffffff;
  font-size: 20px;
  line-height: 44px;
  text-align: center;
  font-weight: bold;
  border-radius: 22px;
  background-color: #1e9b6c;
  border: 2px solid #157d58;
}

.guide-title {
  position: absolute;
  top: 62px;
  height: 36px;
  color: #16231f;
  font-size: 26px;
  line-height: 36px;
  font-weight: bold;
  text-align: center;
}

.guide-list {
  position: absolute;
  top: 108px;
}

.guide-item {
  width: 100%;
}

.guide-card {
  border-radius: 18px;
  background-color: #ffffff;
  border: 2px solid #d7e2dd;
  flex-direction: column;
}

.guide-card-title {
  height: 22px;
  margin-left: 12px;
  margin-top: 8px;
  color: #1e9b6c;
  font-size: 16px;
  line-height: 22px;
  font-weight: bold;
  text-align: left;
}

.guide-card-body {
  margin-left: 12px;
  margin-top: 4px;
  color: #4f5f59;
  font-size: 13px;
  line-height: 18px;
  text-overflow: clip;
  text-align: left;
}
</style>
