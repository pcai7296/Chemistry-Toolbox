<template>
  <div class="guide-page">
    <text class="guide-back" style="left: {{topButtonLeft}}px;width: {{topButtonWidth}}px;" @click="goBack">返回</text>
    <text class="guide-title" style="left: {{titleLeft}}px;width: {{titleWidth}}px;">使用说明</text>
    <list class="guide-list" style="left: {{cardLeft}}px;width: {{cardWidth}}px;height: {{guideListHeight}}px;">
      <list-item type="guide" for="{{guideItems}}" class="guide-item" style="height: {{$item.itemHeight}}px;">
        <div class="guide-card" style="width: {{cardWidth}}px;height: {{$item.cardHeight}}px;border-radius: {{guideCardRadius}}px;">
          <text class="guide-card-title" style="width: {{guideTextWidth}}px;height: {{guideTitleLineHeight}}px;margin-left: {{guideCardPaddingX}}px;margin-top: {{guideCardPaddingTop}}px;font-size: {{guideTitleFontSize}}px;line-height: {{guideTitleLineHeight}}px;">{{$item.title}}</text>
          <text class="guide-card-body" style="width: {{guideTextWidth}}px;height: {{$item.bodyHeight}}px;margin-left: {{guideCardPaddingX}}px;margin-top: {{guideBodyGap}}px;font-size: {{guideBodyFontSize}}px;line-height: {{guideBodyLineHeight}}px;">{{$item.body}}</text>
        </div>
      </list-item>
      <list-item type="bottomSpacer" class="guide-bottom-spacer" style="height: {{guideBottomSpacerHeight}}px;"></list-item>
    </list>
  </div>
</template>

<script>
import router from "@system.router"
import device from "@system.device"
import { applyResponsiveLayout } from "../../services/deviceLayout.js"

const GUIDE_ITEMS = [
  {
    title: "1. 输入分子式",
    body: "分别点击两个输入框，输入想同时查询的两个分子式，例如 HCl 和 NaOH。"
  },
  {
    title: "2. 使用键盘",
    body: "元素键用于输入原子，123 用于输入原子数，荷用于输入正负电荷，组可快速输入常见基团。"
  },
  {
    title: "3. 查看结果",
    body: "按搜索后，会列出同时包含两个分子式的化学方程式。结果较多时可上下滑动或翻页。"
  },
  {
    title: "4. 编辑与删除",
    body: "编辑页点击回车保存，点击红色删除可一键清空当前输入框。"
  },
  {
    title: "注意",
    body: "请尽量输入标准分子式。数据库仍在完善，如有错误或缺漏，可在关于页联系反馈。"
  }
]
const BASE_GUIDE_CARD_WIDTH = 188

function estimateLines(text, charsPerLine) {
  return Math.max(1, Math.ceil((text || "").length / charsPerLine))
}

function buildGuideItems(metrics) {
  const charsPerLine = Math.max(12, Math.floor(metrics.textWidth / Math.max(8, Math.floor(metrics.bodyFontSize))))
  return GUIDE_ITEMS.map((item) => {
    const bodyLines = estimateLines(item.body, charsPerLine)
    const bodyHeight = bodyLines * metrics.bodyLineHeight
    const cardHeight = metrics.cardPaddingTop + metrics.titleLineHeight + metrics.bodyGap + bodyHeight + metrics.cardPaddingBottom
    return Object.assign({}, item, {
      bodyHeight,
      cardHeight,
      itemHeight: cardHeight + metrics.itemGap
    })
  })
}

export default {
  private: {
    screenWidth: 212,
    screenHeight: 520,
    topButtonLeft: 66,
    topButtonWidth: 80,
    titleLeft: 46,
    titleWidth: 120,
    cardLeft: 12,
    cardWidth: 188,
    guideTextWidth: 164,
    guideCardRadius: 18,
    guideCardPaddingX: 12,
    guideCardPaddingTop: 8,
    guideCardPaddingBottom: 10,
    guideBodyGap: 4,
    guideTitleFontSize: 16,
    guideTitleLineHeight: 22,
    guideBodyFontSize: 14,
    guideBodyLineHeight: 19,
    guideListHeight: 370,
    guideBottomSpacerHeight: 20,
    guideItems: buildGuideItems({
      textWidth: 164,
      bodyFontSize: 14,
      bodyLineHeight: 19,
      titleLineHeight: 22,
      cardPaddingTop: 8,
      cardPaddingBottom: 10,
      bodyGap: 4,
      itemGap: 10
    })
  },

  onInit() {
    applyResponsiveLayout(this, device, "pill")
  },

  applyScreenLayout(layout) {
    const isPill = layout.shape === "pill"
    const guideCardWidth = isPill
      ? layout.cardWidth
      : Math.max(layout.cardWidth, Math.floor(layout.screenWidth * (layout.shape === "round" ? 0.76 : 0.84)))
    const guideScale = isPill ? 1 : guideCardWidth / BASE_GUIDE_CARD_WIDTH
    this.screenWidth = layout.screenWidth
    this.screenHeight = layout.screenHeight
    this.topButtonLeft = layout.topButtonLeft
    this.topButtonWidth = layout.topButtonWidth
    this.titleLeft = Math.floor((layout.screenWidth - 120) / 2)
    this.titleWidth = 120
    this.cardLeft = Math.floor((layout.screenWidth - guideCardWidth) / 2)
    this.cardWidth = guideCardWidth
    this.guideCardRadius = Math.floor(18 * guideScale)
    this.guideCardPaddingX = Math.floor(12 * guideScale)
    this.guideCardPaddingTop = Math.floor(8 * guideScale)
    this.guideCardPaddingBottom = Math.floor(10 * guideScale)
    this.guideBodyGap = Math.floor(4 * guideScale)
    this.guideTitleFontSize = Math.floor(16 * guideScale)
    this.guideTitleLineHeight = Math.floor(22 * guideScale)
    this.guideBodyFontSize = Math.floor(14 * guideScale)
    this.guideBodyLineHeight = Math.floor(19 * guideScale)
    this.guideTextWidth = Math.max(136, guideCardWidth - this.guideCardPaddingX * 2)
    this.guideListHeight = layout.guideListHeight
    this.guideBottomSpacerHeight = isPill ? 20 : 0
    this.guideItems = buildGuideItems({
      textWidth: this.guideTextWidth,
      bodyFontSize: this.guideBodyFontSize,
      bodyLineHeight: this.guideBodyLineHeight,
      titleLineHeight: this.guideTitleLineHeight,
      cardPaddingTop: this.guideCardPaddingTop,
      cardPaddingBottom: this.guideCardPaddingBottom,
      bodyGap: this.guideBodyGap,
      itemGap: Math.floor(10 * guideScale)
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.guide-page {
  width: 100%;
  height: 100%;
  background-color: #f4f7f5;
}

.guide-back {
  position: absolute;
  top: 14px;
  height: 44px;
  color: #ffffff;
  font-size: 20px;
  line-height: 44px;
  text-align: center;
  font-weight: bold;
  border-radius: 22px;
  background-color: #1e9b6c;
  border: 2px solid #157d58;
}

.guide-title {
  position: absolute;
  top: 62px;
  height: 36px;
  color: #16231f;
  font-size: 26px;
  line-height: 36px;
  font-weight: bold;
  text-align: center;
}

.guide-list {
  position: absolute;
  top: 108px;
}

.guide-item {
  width: 100%;
}

.guide-card {
  border-radius: 18px;
  background-color: #ffffff;
  border: 2px solid #d7e2dd;
  flex-direction: column;
}

.guide-card-title {
  height: 22px;
  margin-left: 12px;
  margin-top: 8px;
  color: #1e9b6c;
  font-size: 16px;
  line-height: 22px;
  font-weight: bold;
  text-align: left;
}

.guide-card-body {
  margin-left: 12px;
  margin-top: 4px;
  color: #4f5f59;
  font-size: 13px;
  line-height: 18px;
  text-overflow: clip;
  text-align: left;
}
</style>
