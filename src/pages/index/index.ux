  position: absolute;
  top: 0px;
  width: 192px;
  height: 110px;
}

.arc-search {
  position: absolute;
  left: 3px;
  top: 47px;
  width: 186px;
  height: 60px;
}

.candidate-scroll {
  position: absolute;
  left: 15px;
  top: 56px;
  width: 144px;
  height: 42px;
}

.candidate-more {
  position: absolute;
  left: 120px;
  top: 57px;
  width: 60px;
  height: 40px;
}

.icon-btn {
  position: absolute;
  background-color: #000000;
  border-radius: 12px;
  align-items: center;
  justify-content: center;
}

