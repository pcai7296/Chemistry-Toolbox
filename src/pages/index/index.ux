<template>
  <div class="chem-root" @touchstart="handleTouchStart" @touchend="handleTouchEnd">
    <div class="home-view" if="{{!isEditing}}">
      <text class="home-title">化学工具箱</text>
      <div class="home-input" style="width: {{contentWidth}}px;" @click="openEditor">
        <text class="home-input-text" if="{{savedText1}}">{{savedText1Display}}</text>
        <text static class="home-placeholder" if="{{!savedText1}}">点击输入</text>
      </div>
      <div class="home-input second-input" style="width: {{contentWidth}}px;" @click="openSecondEditor">
        <text class="home-input-text" if="{{savedText2}}">{{savedText2Display}}</text>
        <text static class="home-placeholder" if="{{!savedText2}}">点击输入</text>
      </div>
      <div class="search-button" @click="searchEquations">
        <text class="search-button-text">搜索</text>
      </div>
      <div class="secondary-actions" style="width: {{narrowWidth}}px;">
        <div class="sponsor-button" @click="openSponsor">
          <text class="sponsor-button-text">赞助</text>
        </div>
        <div class="about-button" @click="openAbout">
          <text class="about-button-text">关于</text>
        </div>
      </div>
      <div class="guide-button" style="width: {{narrowWidth}}px;" @click="openGuide">
        <text class="guide-button-text">使用说明</text>
      </div>
      <text class="home-hint" if="{{homeMessage}}">{{homeMessage}}</text>
    </div>

    <div class="editor-view" if="{{isEditing}}">
      <div class="editor-input" @click="showKeyboard">
        <scroll id="editorScroll" scroll-x="{{true}}" class="editor-scroll">
          <div class="editor-content">
            <text class="editor-text" if="{{draftText}}">{{draftDisplay}}</text>
            <text static class="editor-placeholder" if="{{!draftText}}">请输入内容</text>
            <text class="cursor" if="{{!hideKeyboard}}"></text>
          </div>
        </scroll>
      </div>
      <div class="editor-actions" if="{{!hideKeyboard}}">
        <text class="enter-button" @click="saveAndCloseEditor">回车</text>
        <text class="clear-button" @click="clearCurrentInput">删除</text>
      </div>
    </div>

    <div class="keyboard-page" if="{{isEditing && !hideKeyboard}}">
      <div class="keyboard-bg">
        <scroll id="keyboard66" scroll-x="{{true}}" onscroll="handelScroll" style="padding-left: {{keyboardKeyPaddingLeft}}px;padding-right: {{keyboardKeyPaddingRight}}px;">
          <div if="{{!numFlag}}" style="left: 3px; flex-direction: column;">
            <div static style="margin-left: 0px;margin-top: 0px;height: 60px;">
              <text class="calbtn66" for="{{item in keys['full'][0]}}" @click="onSelect(item)">{{item}}</text>
            </div>
            <div static style="margin-left: 32px;margin-top: -5px;height: 60px;">
              <text class="calbtn66" for="{{item in keys['full'][1]}}" @click="onSelect(item)">{{item}}</text>
            </div>
            <div static style="margin-left: 64px;margin-top: -5px;height: 60px;">
              <text class="calbtn66" for="{{item in keys['full'][2]}}" @click="onSelect(item)">{{item}}</text>
              <text class="calbtn66" @click="onBtnClick('quickGroup')">{{quickKeyLabel}}</text>
            </div>
          </div>
          <div else style="left: 3px; flex-direction: column;">
            <div static style="margin-left: 0px;margin-top: 0px;height: 60px;">
              <text class="calbtn66" for="{{item in keys['sign'][0]}}" @click="onSelect(item)">{{item}}</text>
            </div>
            <div static style="margin-left: 32px;margin-top: -5px;height: 60px;">
              <text class="calbtn66" for="{{item in keys['sign'][1]}}" @click="onSelect(item)">{{item}}</text>
            </div>
            <div static style="margin-left: 64px;margin-top: -5px;height: 60px;">
              <text class="calbtn66" for="{{item in keys['sign'][2]}}" @click="onSelect(item)">{{item}}</text>
            </div>
          </div>
        </scroll>
      </div>

      <div static class="arc-topbar" style="left: {{keyboardTopbarLeft}}px;width: {{keyboardTopbarWidth}}px;">
        <img static class="arc-search" src="/components/InputMethod/assets/arc/search.png" style="left: {{keyboardSearchLeft}}px;width: {{keyboardSearchWidth}}px;" />
        <scroll id="formulaPreview" scroll-x="{{true}}" class="candidate-scroll" style="left: {{keyboardPreviewLeft}}px;width: {{keyboardPreviewWidth}}px;">
          <div style="position: absolute;left: {{previewMarqueeLeft}}px;top: 0px;height: 42px;width: {{previewMarqueeContentWidth}}px;padding-right:20px">
            <text class="calbtn02 formula-preview" style="width: {{previewMarqueeContentWidth}}px;">{{draftDisplay || topHint}}</text>
          </div>
        </scroll>
        <img show="{{panelRows.length > 0}}" class="candidate-more" src="/components/InputMethod/assets/arc/down2.png" style="left: {{keyboardMoreLeft}}px;" @click="onBtnClick('down')" />
        <div class="icon-btn icon-lang" style="left: {{keyboardGroupLeft}}px;width: {{keyboardGroupWidth}}px;" @click="onPrimaryTopAction">
          <text class="top-btn-text">{{topLeftLabel}}</text>
        </div>
        <div class="icon-btn icon-num" style="left: {{keyboardNumberLeft}}px;width: {{keyboardNumberWidth}}px;" @click="onSecondaryTopAction">
          <text class="top-btn-text">{{topMiddleLabel}}</text>
        </div>
        <div class="icon-btn icon-del" style="left: {{keyboardDeleteLeft}}px;width: {{keyboardDeleteWidth}}px;" @click="onBtnClick('D')">
          <img src="/components/InputMethod/assets/arc/del.png" class="icon-img" />
        </div>
      </div>

      <div class="candidate-panel" if="{{downFlag === 'down'}}">
        <div style="position: absolute;left: {{(screenWidth - 192) / 2}}px;width: 192px;height: 263px;">
          <list static class="list66">
            <list-item type="waitingRows66" class="item66" for="{{itemArray in panelRows}}">
              <div class="item column center" for="{{item in itemArray}}">
                <input class="calbtn0" type="button" value="{{item.label}}" style="font-size: {{item.fontSize}}px;" @click="onPanelSelect(item.label)" />
              </div>
            </list-item>
          </list>
          <img static class="candidate-up" src="/components/InputMethod/assets/arc/up2.png" @click="onBtnClick('down')" />
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import storage from "@system.storage"
import vibrator from "@system.vibrator"
import device from "@system.device"
import router from "@system.router"
import { applyResponsiveLayout } from "../../services/deviceLayout.js"
import { estimateFormulaPreviewWidth, formatInputFormula, splitCharge } from "../../services/formulaFormat.js"

const STORAGE_KEY_1 = "CHEMISTRY_TOOLBOX_HOME_TEXT_1"
const STORAGE_KEY_2 = "CHEMISTRY_TOOLBOX_HOME_TEXT_2"
const STORAGE_KEY_SEARCH_LEFT = "CHEMISTRY_TOOLBOX_SEARCH_LEFT"
const STORAGE_KEY_SEARCH_RIGHT = "CHEMISTRY_TOOLBOX_SEARCH_RIGHT"
const EDGE_THRESHOLD = 28
const EXIT_SWIPE_DISTANCE = 58
const EXIT_SWIPE_MAX_Y_DRIFT = 70

const ELEMENT_KEYS = [
  ["H", "O", "C", "N", "S", "P", "K", "Na", "Cl", "Ca", "As"],
  ["Mg", "Al", "Zn", "Fe", "Cu", "Ag", "Ba", "Si", "Br", "Ti", "Sn"],
  ["Li", "Be", "B", "F", "I", "Cr", "Mn", "Pb", "Hg", "Rb"]
]

const NUMBER_KEYS = [
  ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
  ["(", ")", "+", "-", "2+", "3+", "2-", "3-", "4-"],
  ["[", "]", "·", ".", "OH", "NH4", "SO4"]
]

const GROUP_PANEL_ITEMS = ["OH", "NO3", "SO4", "CO3", "HCO3", "NH4", "PO4", "MnO4", "ClO3"]
const CHARGE_PANEL_ITEMS = ["+", "-", "2+", "3+", "4+", "2-", "3-", "4-", "0"]
function buildRows(items) {
  const rows = []
  let row = []
  for (let i = 0; i < items.length; i += 1) {
    row.push({
      label: items[i],
      fontSize: getPanelFontSize(items[i])
    })
    if (row.length === 3) {
      rows.push(row)
      row = []
    }
  }
  if (row.length > 0) {
    rows.push(row)
  }
  return rows
}

function getPanelFontSize(value) {
  const length = (value || "").length
  if (length <= 2) {
    return 28
  }
  if (length === 3) {
    return 22
  }
  if (length === 4) {
    return 18
  }
  return 15
}

function insertBeforeCharge(raw, token) {
  const parts = splitCharge(raw)
  return parts.body + token + parts.chargeRaw
}

function applyCharge(raw, token) {
  const parts = splitCharge(raw)
  if (!parts.body) {
    return raw || ""
  }
  if (token === "0") {
    return parts.body
  }
  const chargeMatch = token.match(/^(\d*)([+-])$/)
  if (!chargeMatch) {
    return raw
  }
  const digits = chargeMatch[1] || ""
  const sign = chargeMatch[2]
  return parts.body + "^" + digits + sign
}

function deleteLastInput(raw) {
  const parts = splitCharge(raw)
  if (parts.chargeRaw) {
    return parts.body
  }
  return (raw || "").slice(0, -1)
}

function isChargeToken(token) {
  return /^(\d*)([+-])$/.test(token) || token === "0"
}

export default {
  private: {
    savedText1: "",
    savedText2: "",
    savedText1Display: "",
    savedText2Display: "",
    draftText: "",
    draftDisplay: "",
    activeInput: 1,
    isEditing: false,
    hideKeyboard: true,
    homeMessage: "",
    isSearching: false,
    searchDotCount: 1,
    downFlag: "",
    numFlag: false,
    percent66: 0,
    screenWidth: 212,
    screenHeight: 520,
    screenShape: "pill",
    contentWidth: 180,
    narrowWidth: 176,
    keyboardTopbarWidth: 192,
    keyboardTopbarLeft: 10,
    keyboardSearchLeft: 3,
    keyboardSearchWidth: 186,
    keyboardPreviewLeft: 15,
    keyboardPreviewWidth: 144,
    keyboardPreviewTextWidth: 226,
    keyboardKeyPaddingLeft: 10,
    keyboardKeyPaddingRight: 10,
    keyboardInitialScrollLeft: 0,
    previewMarqueeLeft: 0,
    previewMarqueeEnabled: false,
    previewMarqueeContentWidth: 226,
    keyboardMoreLeft: 120,
    keyboardGroupLeft: 9,
    keyboardGroupWidth: 48,
    keyboardNumberLeft: 70,
    keyboardNumberWidth: 48,
    keyboardDeleteLeft: 135,
    keyboardDeleteWidth: 48,
    topHint: "请输入分子式",
    topLeftLabel: "组",
    topMiddleLabel: "123",
    quickKeyLabel: "OH",
    panelRows: [],
    keys: {
      full: ELEMENT_KEYS,
      sign: NUMBER_KEYS
    }
  },

  onInit() {
    this.touchStartX = null
    this.touchStartY = null
    this.searchLoadingTimer = null
    this.previewMarqueeTimer = null
    this.didNavigateToResults = false
    this.loadSavedText()
    this.refreshKeyboardState()
    applyResponsiveLayout(this, device, this.screenShape)
  },

  applyScreenLayout(layout) {
    this.screenWidth = layout.screenWidth
    this.screenHeight = layout.screenHeight
    this.screenShape = layout.shape
    this.contentWidth = layout.contentWidth
    this.narrowWidth = layout.narrowWidth
    this.keyboardTopbarWidth = layout.keyboardTopbarWidth
    this.keyboardTopbarLeft = layout.keyboardTopbarLeft
    this.keyboardSearchLeft = layout.keyboardSearchLeft
    this.keyboardSearchWidth = layout.keyboardSearchWidth
    this.keyboardPreviewLeft = layout.keyboardPreviewLeft
    this.keyboardPreviewWidth = layout.keyboardPreviewWidth
    this.keyboardPreviewTextWidth = layout.keyboardPreviewTextWidth
    this.keyboardKeyPaddingLeft = layout.keyboardKeyPaddingLeft
    this.keyboardKeyPaddingRight = layout.keyboardKeyPaddingRight
    this.keyboardInitialScrollLeft = layout.keyboardInitialScrollLeft
    this.keyboardMoreLeft = layout.keyboardMoreLeft
    this.keyboardGroupLeft = layout.keyboardGroupLeft
    this.keyboardGroupWidth = layout.keyboardGroupWidth
    this.keyboardNumberLeft = layout.keyboardNumberLeft
    this.keyboardNumberWidth = layout.keyboardNumberWidth
    this.keyboardDeleteLeft = layout.keyboardDeleteLeft
    this.keyboardDeleteWidth = layout.keyboardDeleteWidth
    this.updatePreviewMarqueeState()
  },

  onShow() {
    if (this.didNavigateToResults) {
      this.didNavigateToResults = false
      this.clearSearchLoading(true)
    }
  },

  onHide() {
    this.stopPreviewMarquee()
    if (!this.didNavigateToResults) {
      this.clearSearchLoading(true)
    }
  },

  onDestroy() {
    this.stopPreviewMarquee()
    this.clearSearchLoading(true)
  },

  loadSavedText() {
    storage.get({
      key: STORAGE_KEY_1,
      success: (data) => {
        this.setSavedText(1, data || "")
      },
      fail: () => {
        this.setSavedText(1, "")
      }
    })
    storage.get({
      key: STORAGE_KEY_2,
      success: (data) => {
        this.setSavedText(2, data || "")
      },
      fail: () => {
        this.setSavedText(2, "")
      }
    })
  },

  openEditor() {
    this.clearSearchLoading(true)
    this.activeInput = 1
    this.setDraftText(this.savedText1 || "")
    this.isEditing = true
    this.hideKeyboard = false
    this.downFlag = ""
    this.scrollEditorToEnd()
    this.scrollKeyboardToInitial()
    this.startPreviewMarquee()
  },

  openSecondEditor() {
    this.clearSearchLoading(true)
    this.activeInput = 2
    this.setDraftText(this.savedText2 || "")
    this.isEditing = true
    this.hideKeyboard = false
    this.downFlag = ""
    this.scrollEditorToEnd()
    this.scrollKeyboardToInitial()
    this.startPreviewMarquee()
  },

  showKeyboard() {
    this.hideKeyboard = false
    this.scrollEditorToEnd()
    this.scrollKeyboardToInitial()
    this.startPreviewMarquee()
  },

  hideEditorKeyboard() {
    this.hideKeyboard = true
    this.downFlag = ""
    this.stopPreviewMarquee()
    this.scrollEditorToEnd()
  },

  setDraftText(value) {
    this.draftText = value || ""
    this.draftDisplay = formatInputFormula(this.draftText)
    this.updatePreviewMarqueeState()
  },

  setSavedText(inputIndex, value) {
    const raw = value || ""
    if (inputIndex === 2) {
      this.savedText2 = raw
      this.savedText2Display = formatInputFormula(raw)
      return
    }
    this.savedText1 = raw
    this.savedText1Display = formatInputFormula(raw)
  },

  insertToken(token) {
    if (!token) {
      return
    }
    if (isChargeToken(token)) {
      this.setDraftText(applyCharge(this.draftText, token))
    } else {
      this.setDraftText(insertBeforeCharge(this.draftText, token))
    }
    this.downFlag = ""
    this.scrollEditorToEnd()
    this.scrollFormulaPreviewToEnd()
  },

  onSelect(key) {
    this.onVibrate()
    this.insertToken(key)
  },

  onBtnClick(sign) {
    this.onVibrate()
    switch (sign) {
      case "D":
        this.setDraftText(deleteLastInput(this.draftText))
        this.downFlag = ""
        this.scrollEditorToEnd()
        this.scrollFormulaPreviewToEnd()
        break
      case "down":
        this.downFlag = this.downFlag === "down" ? "" : "down"
        break
      case "switchNum":
        this.numFlag = true
        this.downFlag = ""
        this.refreshKeyboardState()
        break
      case "switchElements":
        this.numFlag = false
        this.downFlag = ""
        this.refreshKeyboardState()
        break
      case "toggleGroups":
        this.numFlag = false
        this.refreshKeyboardState()
        this.downFlag = this.downFlag === "down" ? "" : "down"
        break
      case "toggleCharges":
        this.numFlag = true
        this.refreshKeyboardState()
        this.downFlag = this.downFlag === "down" ? "" : "down"
        break
      case "quickGroup":
        this.insertToken(this.quickKeyLabel)
        break
      default:
        break
    }
  },

  onPrimaryTopAction() {
    if (this.numFlag) {
      this.onBtnClick("switchElements")
      return
    }
    this.onBtnClick("toggleGroups")
  },

  onSecondaryTopAction() {
    if (this.numFlag) {
      this.onBtnClick("toggleCharges")
      return
    }
    this.onBtnClick("switchNum")
  },

  onPanelSelect(item) {
    this.onVibrate()
    this.insertToken(item)
  },

  refreshKeyboardState() {
    this.keys.full = ELEMENT_KEYS
    this.keys.sign = NUMBER_KEYS
    if (this.numFlag) {
      this.topLeftLabel = "元"
      this.topMiddleLabel = "荷"
      this.topHint = "数字 / 电荷"
      this.quickKeyLabel = "OH"
      this.panelRows = buildRows(CHARGE_PANEL_ITEMS)
      this.updatePreviewMarqueeState()
      return
    }
    this.topLeftLabel = "组"
    this.topMiddleLabel = "123"
    this.topHint = "元素 / 基团"
    this.quickKeyLabel = "OH"
    this.panelRows = buildRows(GROUP_PANEL_ITEMS)
    this.updatePreviewMarqueeState()
  },

  handelScroll(event) {
    const value = parseInt((event.scrollX / 633) * 100)
    this.percent66 = value <= 100 ? value : 100
  },

  handleTouchStart(eve) {
    if (!this.isEditing) {
      return
    }
    this.touchStartX = this.getPoint(eve, "x")
    this.touchStartY = this.getPoint(eve, "y")
  },

  handleTouchEnd(eve) {
    if (!this.isEditing) {
      return
    }

    const endX = this.getPoint(eve, "x")
    const endY = this.getPoint(eve, "y")
    if (this.touchStartX === null || endX === null) {
      return
    }

    const deltaX = endX - this.touchStartX
    const deltaY = Math.abs((endY || 0) - (this.touchStartY || 0))
    if (this.touchStartX <= EDGE_THRESHOLD && deltaX >= EXIT_SWIPE_DISTANCE && deltaY <= EXIT_SWIPE_MAX_Y_DRIFT && this.draftText) {
      this.saveAndCloseEditor()
    }

    this.touchStartX = null
    this.touchStartY = null
  },

  saveAndCloseEditor() {
    if (this.activeInput === 2) {
      this.setSavedText(2, this.draftText)
    } else {
      this.setSavedText(1, this.draftText)
    }
    this.hideKeyboard = true
    this.isEditing = false
    this.downFlag = ""
    this.stopPreviewMarquee()
    storage.set({
      key: this.activeInput === 2 ? STORAGE_KEY_2 : STORAGE_KEY_1,
      value: this.draftText
    })
  },

  clearCurrentInput() {
    this.onVibrate()
    this.setDraftText("")
    if (this.activeInput === 2) {
      this.setSavedText(2, "")
    } else {
      this.setSavedText(1, "")
    }
    storage.set({
      key: this.activeInput === 2 ? STORAGE_KEY_2 : STORAGE_KEY_1,
      value: ""
    })
    this.downFlag = ""
    this.refreshKeyboardState()
  },

  normalizeFormula(value) {
    return (value || "").replace(/\s+/g, "")
  },

  searchEquations() {
    if (this.isSearching) {
      return
    }

    const formula1 = this.normalizeFormula(this.savedText1)
    const formula2 = this.normalizeFormula(this.savedText2)

    if (!formula1 || !formula2) {
      this.clearSearchLoading(false)
      this.homeMessage = "请先输入两个分子式"
      return
    }

    this.startSearchLoading()
    this.saveSearchInputs(formula1, formula2)
    this.didNavigateToResults = true
    router.push({
      uri: "/pages/results"
    })
  },

  saveSearchInputs(formula1, formula2) {
    storage.set({
      key: STORAGE_KEY_SEARCH_LEFT,
      value: formula1
    })
    storage.set({
      key: STORAGE_KEY_SEARCH_RIGHT,
      value: formula2
    })
  },

  openSponsor() {
    this.onVibrate()
    router.push({
      uri: "/pages/sponsor"
    })
  },

  openAbout() {
    this.onVibrate()
    router.push({
      uri: "/pages/about"
    })
  },

  openGuide() {
    this.onVibrate()
    router.push({
      uri: "/pages/guide"
    })
  },

  startSearchLoading() {
    this.clearSearchLoading(false)
    this.isSearching = true
    this.searchDotCount = 1
    this.updateSearchLoadingText()
    this.queueSearchLoadingTick()
  },

  queueSearchLoadingTick() {
    this.searchLoadingTimer = setTimeout(() => {
      if (!this.isSearching) {
        return
      }
      this.searchDotCount = this.searchDotCount >= 6 ? 1 : this.searchDotCount + 1
      this.updateSearchLoadingText()
      this.queueSearchLoadingTick()
    }, 500)
  },

  updateSearchLoadingText() {
    let dots = ""
    for (let i = 0; i < this.searchDotCount; i += 1) {
      dots += "."
    }
    this.homeMessage = "搜索中" + dots
  },

  clearSearchLoading(clearMessage) {
    if (this.searchLoadingTimer) {
      clearTimeout(this.searchLoadingTimer)
      this.searchLoadingTimer = null
    }
    this.isSearching = false
    this.searchDotCount = 1
    if (clearMessage) {
      this.homeMessage = ""
    }
  },

  getPoint(eve, axis) {
    if (!eve) {
      return null
    }
    const point = (eve.touches && eve.touches[0]) || (eve.changedTouches && eve.changedTouches[0]) || eve
    const candidates = axis === "x"
      ? ["globalX", "screenX", "clientX", "pageX", "x"]
      : ["globalY", "screenY", "clientY", "pageY", "y"]
    for (let i = 0; i < candidates.length; i += 1) {
      const key = candidates[i]
      if (typeof point[key] === "number") {
        return point[key]
      }
    }
    return null
  },

  scrollFormulaPreviewToEnd() {
    if (this.previewMarqueeEnabled) {
      return
    }
    setTimeout(() => {
      if (this.$element("formulaPreview")) {
        this.$element("formulaPreview").scrollTo({
          top: 0,
          left: 9999,
          behavior: "smooth"
        })
      }
    }, 0)
  },

  startPreviewMarquee() {
    this.stopPreviewMarquee()
    this.updatePreviewMarqueeState()
  },

  schedulePreviewMarquee() {
    this.previewMarqueeTimer = setTimeout(() => {
      if (!this.isEditing || this.hideKeyboard) {
        this.previewMarqueeTimer = null
        return
      }
      if (!this.previewMarqueeEnabled) {
        this.previewMarqueeTimer = null
        return
      }
      const nextLeft = this.previewMarqueeLeft - 8
      if (nextLeft < -this.previewMarqueeContentWidth) {
        this.previewMarqueeLeft = this.keyboardPreviewWidth
      } else {
        this.previewMarqueeLeft = nextLeft
      }
      this.schedulePreviewMarquee()
    }, 90)
  },

  stopPreviewMarquee() {
    if (this.previewMarqueeTimer) {
      clearTimeout(this.previewMarqueeTimer)
      this.previewMarqueeTimer = null
    }
  },

  updatePreviewMarqueeState() {
    const textWidth = estimateFormulaPreviewWidth(this.draftDisplay || this.topHint)
    this.previewMarqueeEnabled = textWidth > this.keyboardPreviewWidth
    this.previewMarqueeContentWidth = this.previewMarqueeEnabled ? textWidth + 18 : this.keyboardPreviewWidth
    if (!this.previewMarqueeEnabled) {
      this.previewMarqueeLeft = 0
      this.stopPreviewMarquee()
      return
    }
    if (this.isEditing && !this.hideKeyboard && !this.previewMarqueeTimer) {
      this.previewMarqueeLeft = this.keyboardPreviewWidth
      this.schedulePreviewMarquee()
    }
  },

  scrollEditorToEnd() {
    setTimeout(() => {
      if (this.isEditing && this.$element("editorScroll")) {
        this.$element("editorScroll").scrollTo({
          top: 0,
          left: 9999,
          behavior: "smooth"
        })
      }
    }, 0)
  },

  scrollKeyboardToInitial() {
    setTimeout(() => {
      if (this.isEditing && !this.hideKeyboard && this.$element("keyboard66")) {
        this.$element("keyboard66").scrollTo({
          top: 0,
          left: this.keyboardInitialScrollLeft,
          behavior: "smooth"
        })
      }
    }, 0)
  },

  onVibrate() {
    vibrator.vibrate({ mode: "short" })
  }
}
</script>

