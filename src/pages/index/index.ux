}

.arc-progress {
  start-angle: 204deg;
  total-angle: -48deg;
  width: 188px;
  height: 188px;
  top: 82px;
  left: 2px;
  position: absolute;
  color: #ffffff;
  stroke-width: 6px;
  layer-color: #262626;
}

