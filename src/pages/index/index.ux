<template>
  <div class="chem-root" @touchstart="handleTouchStart" @touchend="handleTouchEnd">
    <div class="home-view" if="{{!isEditing && !isViewingResults}}">
      <text class="home-title">化学工具箱</text>
      <div class="home-input" @click="openEditor">
        <text class="home-input-text" if="{{savedText1}}">{{savedText1}}</text>
        <text static class="home-placeholder" if="{{!savedText1}}">点击输入</text>
      </div>
      <div class="home-input second-input" @click="openSecondEditor">
        <text class="home-input-text" if="{{savedText2}}">{{savedText2}}</text>
        <text static class="home-placeholder" if="{{!savedText2}}">点击输入</text>
      </div>
      <div class="search-button" @click="searchEquations">
        <text class="search-button-text">搜索</text>
      </div>
      <text class="home-hint" if="{{homeMessage}}">{{homeMessage}}</text>
    </div>

    <div class="results-view" if="{{isViewingResults}}">
      <div class="results-topbar">
        <text class="results-back" @click="backToHome">返回</text>
        <text class="results-title">查询结果</text>
      </div>
      <text class="results-query">{{searchFormula1}} + {{searchFormula2}}</text>
      <text class="results-subtitle" if="{{searchResults.length}}">同时包含这两个分子式的方程式</text>
      <text class="results-empty" if="{{!searchResults.length}}">没有找到同时包含这两个分子式的方程式</text>
      <scroll class="results-scroll" scroll-y="{{true}}" if="{{searchResults.length}}">
        <div class="results-list">
          <div class="result-card" for="{{item in searchResults}}">
            <text class="result-equation">{{item.equation}}</text>
            <text class="result-meta">类型：{{item.type}}</text>
            <text class="result-meta">条件：{{item.conditions}}</text>
            <text class="result-meta">现象：{{item.phenomenon}}</text>
          </div>
        </div>
      </scroll>
    </div>

    <div class="editor-view" if="{{isEditing}}">
      <div class="editor-input" @click="showKeyboard">
        <scroll id="editorScroll" scroll-x="{{true}}" class="editor-scroll">
          <div class="editor-content">
            <text class="editor-text" if="{{draftText}}">{{draftText}}</text>
            <text static class="editor-placeholder" if="{{!draftText}}">请输入内容</text>
            <text class="cursor" if="{{!hideKeyboard}}"></text>
          </div>
        </scroll>
      </div>
      <text class="enter-button" if="{{!hideKeyboard}}" @click="saveAndCloseEditor">回车</text>
    </div>

    <div class="keyboard-page" if="{{isEditing && !hideKeyboard}}">
      <div class="keyboard-bg">
        <progress percent="{{30 + percent66}}" type="arc" class="arc-progress" style="margin-left: {{(screenWidth - 192) / 2}}px;"></progress>
        <scroll id="keyboard66" scroll-x="{{true}}" onscroll="handelScroll" style="padding-left: {{(screenWidth - 192) / 2}}px;padding-right: {{(screenWidth - 192) / 2}}px;">
          <div if="{{!numFlag}}" style="left: 3px; flex-direction: column;">
            <div static style="margin-left: 0px;margin-top: 0px;height: 60px;">
              <text class="calbtn66" for="{{item in keys['full'][0]}}" @click="onSelect(item)">{{item}}</text>
            </div>
            <div static style="margin-left: 32px;margin-top: -5px;height: 60px;">
              <text class="calbtn66" for="{{item in keys['full'][1]}}" @click="onSelect(item)">{{item}}</text>
            </div>
            <div static style="margin-left: 64px;margin-top: -5px;height: 60px;">
              <text class="calbtn66" for="{{item in keys['full'][2]}}" @click="onSelect(item)">{{item}}</text>
              <img static src="/components/InputMethod/assets/arc/space.png" style="width: 60px;height: 60px;" @click="onBtnClick('space')" />
            </div>
          </div>
          <div else style="left: 3px; flex-direction: column;">
            <div static style="margin-left: 0px;margin-top: 0px;height: 60px;">
              <text class="calbtn66" for="{{item in keys['sign'][0]}}" @click="onSelect(item)">{{item}}</text>
            </div>
            <div static style="margin-left: 32px;margin-top: -5px;height: 60px;">
              <text class="calbtn66" for="{{item in keys['sign'][1]}}" @click="onSelect(item)">{{item}}</text>
            </div>
            <div static style="margin-left: 64px;margin-top: -5px;height: 60px;">
              <text class="calbtn66" for="{{item in keys['sign'][2]}}" @click="onSelect(item)">{{item}}</text>
            </div>
          </div>
        </scroll>
      </div>

      <div static class="arc-topbar" style="left: {{(screenWidth - 192) / 2}}px;">
        <img static class="arc-search" src="/components/InputMethod/assets/arc/search.png" />
        <scroll id="cvalWaiting" scroll-x="{{true}}" class="candidate-scroll">
          <div style="position: absolute;left: 0px;top: 0px;height: 42px;padding-right:20px">
            <text class="calbtn02" style="padding-right:10px" @click="pushCval">{{cval}}</text>
            <text for="{{cvalList}}" show="{{resultList.length > $idx}}" class="calbtn02" style="padding-right:10px" @click="onRsSelect(resultList[$idx])">{{resultList[$idx]}}</text>
          </div>
        </scroll>
        <img show="{{resultList.length > 0}}" class="candidate-more" src="/components/InputMethod/assets/arc/down2.png" @click="onBtnClick('down')" />
        <div class="icon-btn icon-lang" @click="onBtnClick('lang')" show="{{downFlag === '' && !numFlag && lang === 'cn'}}">
          <img src="/components/InputMethod/assets/arc/cn.png" class="icon-img" />
        </div>
        <div class="icon-btn icon-lang" @click="onBtnClick('lang')" show="{{downFlag === '' && !numFlag && lang === 'en'}}">
          <img src="/components/InputMethod/assets/arc/en.png" class="icon-img" />
        </div>
        <div class="icon-btn icon-lang" @click="onBtnClick('switchCn')" show="{{numFlag && lang === 'cn'}}">
          <img src="/components/InputMethod/assets/arc/back2.png" class="icon-img" />
        </div>
        <div class="icon-btn icon-num" @click="onBtnClick('switchNum')" show="{{downFlag === '' && !numFlag && lang === 'cn'}}">
          <img src="/components/InputMethod/assets/arc/123.png" class="icon-img" />
        </div>
        <div class="icon-btn icon-num" @click="onBtnClick('switchLow')" show="{{downFlag === '' && upperFlag && lang === 'en'}}">
          <img src="/components/InputMethod/assets/arc/bigA.png" class="icon-img" />
        </div>
        <div class="icon-btn icon-num" @click="onBtnClick('switchUpper')" show="{{downFlag === '' && !upperFlag && lang === 'en'}}">
          <img src="/components/InputMethod/assets/arc/a.png" class="icon-img" />
        </div>
        <div class="icon-btn icon-del" @click="onBtnClick('D')">
          <img src="/components/InputMethod/assets/arc/del.png" class="icon-img" />
        </div>
      </div>

      <div class="candidate-panel" if="{{downFlag === 'down'}}">
        <div style="position: absolute;left: {{(screenWidth - 192) / 2}}px;width: 192px;height: 263px;">
          <list static class="list66">
            <list-item type="waitingRows66" class="item66" for="{{itemArray in resultList2}}">
              <div class="item column center" for="{{item in itemArray}}">
                <input class="calbtn0" type="button" value="{{item}}" @click="onRsSelect(item)" />
              </div>
            </list-item>
          </list>
          <img static class="candidate-up" src="/components/InputMethod/assets/arc/up2.png" @click="onBtnClick('down')" />
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import storage from "@system.storage"
import vibrator from "@system.vibrator"
import device from "@system.device"
import { SimpleInputMethod } from "../../components/InputMethod/assets/dicUtil.js"
import { formatFormula, searchReactionsByPair } from "../../services/chemSearch.js"

const STORAGE_KEY_1 = "CHEMISTRY_TOOLBOX_HOME_TEXT_1"
const STORAGE_KEY_2 = "CHEMISTRY_TOOLBOX_HOME_TEXT_2"
const EDGE_THRESHOLD = 28
const EXIT_SWIPE_DISTANCE = 58
const EXIT_SWIPE_MAX_Y_DRIFT = 70

function getHanzi(word, cb) {
  const hanzi = SimpleInputMethod.getHanzi(word)
  cb(hanzi && hanzi[0] ? hanzi[0] : [])
}

export default {
  private: {
    savedText1: "",
    savedText2: "",
    draftText: "",
    activeInput: 1,
    isEditing: false,
    isViewingResults: false,
    hideKeyboard: true,
    homeMessage: "",
    searchFormula1: "",
    searchFormula2: "",
    searchResults: [],
    cval: "",
    resultList: [],
    resultList2: [],
    downFlag: "",
    lang: "cn",
    numFlag: false,
    upperFlag: false,
    percent66: 0,
    screenWidth: 212,
    cvalList: [0, 1, 2],
    keys: {
      full: [
        ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
        ["A", "S", "D", "F", "G", "H", "J", "K", "L"],
        ["Z", "X", "C", "V", "B", "N", "M"]
      ],
      sign: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["~", "!", "@", "#", "%", "“", "”", "*", "?", "/"],
        ["(", ")", "-", "_", ":", ";", "，", "。", "."]
      ]
    }
  },

  onInit() {
    this.touchStartX = null
    this.touchStartY = null
    this.loadSavedText()
    device.getInfo({
      success: (data) => {
        if (data && data.screenWidth) {
          this.screenWidth = data.screenWidth
        }
      }
    })
  },

  loadSavedText() {
    storage.get({
      key: STORAGE_KEY_1,
      success: (data) => {
        this.savedText1 = data || ""
      },
      fail: () => {
        this.savedText1 = ""
      }
    })
    storage.get({
      key: STORAGE_KEY_2,
      success: (data) => {
        this.savedText2 = data || ""
      },
      fail: () => {
        this.savedText2 = ""
      }
    })
  },

  openEditor() {
    this.homeMessage = ""
    this.activeInput = 1
    this.draftText = this.savedText1 || ""
    this.isEditing = true
    this.hideKeyboard = false
    this.scrollEditorToEnd()
  },

  openSecondEditor() {
    this.homeMessage = ""
    this.activeInput = 2
    this.draftText = this.savedText2 || ""
    this.isEditing = true
    this.hideKeyboard = false
    this.scrollEditorToEnd()
  },

  showKeyboard() {
    this.hideKeyboard = false
    this.scrollEditorToEnd()
  },

  hideEditorKeyboard() {
    this.hideKeyboard = true
    this.downFlag = ""
    this.scrollEditorToEnd()
  },

  addText(txt) {
    this.draftText += txt
    this.scrollEditorToEnd()
  },

  onSelect(key) {
    this.onVibrate()
    if (this.lang === "cn" && !this.numFlag) {
      this.cval += key.toLowerCase()
      this.resetResultList()
      return
    }
    if (this.lang === "en" && !this.numFlag) {
      this.addText(this.upperFlag ? key.toUpperCase() : key.toLowerCase())
      return
    }
    this.addText(key)
  },

  onBtnClick(sign) {
    this.onVibrate()
    switch (sign) {
      case "lang":
        this.lang = this.lang === "cn" ? "en" : "cn"
        this.clearComposition()
        break
      case "D":
        if (this.cval) {
          this.cval = this.cval.slice(0, -1)
          this.resetResultList()
        } else if (this.draftText) {
          this.draftText = this.draftText.slice(0, -1)
          this.scrollEditorToEnd()
        }
        break
      case "space":
        this.pushCval()
        this.addText(" ")
        break
      case "down":
        this.downFlag = this.downFlag === "down" ? "" : "down"
        break
      case "switchNum":
        this.numFlag = true
        this.clearComposition()
        break
      case "switchCn":
        this.numFlag = false
        break
      case "switchUpper":
        this.upperFlag = true
        break
      case "switchLow":
        this.upperFlag = false
        break
      default:
        break
    }
  },

  onRsSelect(txt) {
    this.onVibrate()
    this.addText(txt)
    this.clearComposition()
  },

  pushCval() {
    if (this.cval) {
      this.addText(this.cval)
      this.clearComposition()
    }
  },

  clearComposition() {
    this.cval = ""
    this.resultList = []
    this.resultList2 = []
    this.downFlag = ""
  },

  resetResultList() {
    if (this.$element("cvalWaiting")) {
      this.$element("cvalWaiting").scrollTo({
        top: 0,
        left: 0,
        behavior: "smooth"
      })
    }
    if (!this.cval || this.lang !== "cn") {
      this.resultList = []
      this.resultList2 = []
      return
    }
    getHanzi(this.cval, (data) => {
      this.resultList = data || []
      this.setResultListAll()
    })
  },

  setResultListAll() {
    const rows = []
    let row = []
    for (let i = 0; i < this.resultList.length; i += 1) {
      row.push(this.resultList[i])
      if (row.length === 3) {
        rows.push(row)
        row = []
      }
    }
    if (row.length > 0) {
      rows.push(row)
    }
    this.resultList2 = rows
  },

  handelScroll(event) {
    const value = parseInt((event.scrollX / 633) * 100)
    this.percent66 = value <= 100 ? value : 100
  },

  handleTouchStart(eve) {
    if (!this.isEditing) {
      return
    }
    this.touchStartX = this.getPoint(eve, "x")
    this.touchStartY = this.getPoint(eve, "y")
  },

  handleTouchEnd(eve) {
    if (!this.isEditing) {
      return
    }

    const endX = this.getPoint(eve, "x")
    const endY = this.getPoint(eve, "y")
    if (this.touchStartX === null || endX === null) {
      return
    }

    const deltaX = endX - this.touchStartX
    const deltaY = Math.abs((endY || 0) - (this.touchStartY || 0))
    if (this.touchStartX <= EDGE_THRESHOLD && deltaX >= EXIT_SWIPE_DISTANCE && deltaY <= EXIT_SWIPE_MAX_Y_DRIFT && this.draftText) {
      this.saveAndCloseEditor()
    }

    this.touchStartX = null
    this.touchStartY = null
  },

  saveAndCloseEditor() {
    this.pushCval()
    if (this.activeInput === 2) {
      this.savedText2 = this.draftText
    } else {
      this.savedText1 = this.draftText
    }
    this.hideKeyboard = true
    this.isEditing = false
    storage.set({
      key: this.activeInput === 2 ? STORAGE_KEY_2 : STORAGE_KEY_1,
      value: this.draftText
    })
  },

  searchEquations() {
    const formula1 = formatFormula(this.savedText1)
    const formula2 = formatFormula(this.savedText2)

    if (!formula1 || !formula2) {
      this.homeMessage = "请先输入两个分子式"
      return
    }

    this.homeMessage = ""
    this.searchFormula1 = formula1
    this.searchFormula2 = formula2
    this.searchResults = searchReactionsByPair(formula1, formula2)
    this.isViewingResults = true
  },

  backToHome() {
    this.isViewingResults = false
  },

  getPoint(eve, axis) {
    if (!eve) {
      return null
    }
    const point = (eve.touches && eve.touches[0]) || (eve.changedTouches && eve.changedTouches[0]) || eve
    const candidates = axis === "x"
      ? ["globalX", "screenX", "clientX", "pageX", "x"]
      : ["globalY", "screenY", "clientY", "pageY", "y"]
    for (let i = 0; i < candidates.length; i += 1) {
      const key = candidates[i]
      if (typeof point[key] === "number") {
        return point[key]
      }
    }
    return null
  },

  scrollEditorToEnd() {
    setTimeout(() => {
      if (this.isEditing && this.$element("editorScroll")) {
        this.$element("editorScroll").scrollTo({
          top: 0,
          left: 9999,
          behavior: "smooth"
        })
      }
    }, 0)
  },

  onVibrate() {
    vibrator.vibrate({ mode: "short" })
  }
}
</script>

<style>
