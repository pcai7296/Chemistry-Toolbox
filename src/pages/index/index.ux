<template>
  <div class="home-page">
    <text class="home-title" style="left: {{titleLeft}}px;width: {{titleWidth}}px;">化学工具箱</text>
    <div class="main-actions" style="left: {{contentLeft}}px;width: {{contentWidth}}px;">
      <div class="periodic-button" @click="openPeriodic">
        <text class="periodic-button-title">周期表</text>
        <text class="periodic-button-subtitle">元素速查</text>
      </div>
      <div class="search-button" @click="openSearch">
        <text class="search-button-title">搜索</text>
        <text class="search-button-subtitle">方程式查询</text>
      </div>
    </div>
    <div class="secondary-actions" style="left: {{narrowLeft}}px;width: {{narrowWidth}}px;">
      <div class="sponsor-button" @click="openSponsor">
        <text class="secondary-button-text sponsor-text">赞助</text>
      </div>
      <div class="about-button" @click="openAbout">
        <text class="secondary-button-text about-text">关于</text>
      </div>
    </div>
    <div class="guide-button" style="left: {{narrowLeft}}px;width: {{narrowWidth}}px;" @click="openGuide">
      <text class="guide-button-text">使用说明</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import vibrator from "@system.vibrator"
import device from "@system.device"
import { applyResponsiveLayout } from "../../services/deviceLayout.js"

export default {
  private: {
    screenWidth: 212,
    screenHeight: 520,
    screenShape: "pill",
    titleLeft: 28,
    titleWidth: 156,
    contentLeft: 16,
    contentWidth: 180,
    narrowLeft: 18,
    narrowWidth: 176
  },

  onInit() {
    applyResponsiveLayout(this, device, "pill")
  },

  applyScreenLayout(layout) {
    this.screenWidth = layout.screenWidth
    this.screenHeight = layout.screenHeight
    this.screenShape = layout.shape
    this.titleLeft = layout.titleLeft
    this.titleWidth = layout.titleWidth
    this.contentLeft = layout.contentLeft
    this.contentWidth = layout.contentWidth
    this.narrowLeft = layout.narrowLeft
    this.narrowWidth = layout.narrowWidth
  },

  openPeriodic() {
    this.onVibrate()
    router.push({
      uri: "/pages/periodic"
    })
  },

  openSearch() {
    this.onVibrate()
    router.push({
      uri: "/pages/search"
    })
  },

  openSponsor() {
    this.onVibrate()
    router.push({
      uri: "/pages/sponsor"
    })
  },

  openAbout() {
    this.onVibrate()
    router.push({
      uri: "/pages/about"
    })
  },

  openGuide() {
    this.onVibrate()
    router.push({
      uri: "/pages/guide"
    })
  },

  onVibrate() {
    vibrator.vibrate({ mode: "short" })
  }
}
</script>

