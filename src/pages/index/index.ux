  width: 100%;
  height: 100%;
}

.icon-lang {
  top: 0px;
  left: 9px;
  width: 48px;
  height: 42px;
}

.icon-num {
  position: absolute;
  left: 70px;
  top: 0px;
  width: 52px;
  height: 42px;
}

.icon-del {
  position: absolute;
  left: 135px;
  top: 0px;
  width: 48px;
  height: 42px;
}

.candidate-panel {
  position: absolute;
  top: 47px;
  width: 100%;
  height: 263px;
  background-color: #000000;
}

.candidate-up {
  position: absolute;
  top: 196px;
  left: 56px;
  width: 80px;
  height: 60px;
