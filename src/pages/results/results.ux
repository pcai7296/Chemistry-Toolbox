<template>
  <div class="page" @touchstart="handleTouchStart" @touchmove="handleTouchMove" @touchend="handleTouchEnd">
    <list id="resultsList" class="results-listview" if="{{visibleResults.length > 0}}" style="left: {{cardLeft}}px;width: {{cardWidth}}px;height: {{screenHeight}}px;padding: {{resultsListTopPadding}}px 0px {{resultsListBottomPadding}}px;">
      <list-item type="tip" class="results-tip-item">
        <text class="results-subtitle">同时包含这两个分子式的方程式</text>
      </list-item>
      <list-item type="result" for="{{visibleResults}}" class="result-card-item" style="{{$item.itemStyle}}">
        <div class="result-card" style="{{$item.cardStyle}}">
          <div class="result-equation-line" for="{{line in $item.leftLines}}" style="{{line.rowStyle}}">
            <text class="result-equation-side" style="{{line.textStyle}}">{{line.text}}</text>
          </div>
          <text class="result-equation-arrow" style="font-size: {{resultArrowFontSize}}px;line-height: {{resultArrowLineHeight}}px;">→</text>
          <div class="result-equation-line" for="{{line in $item.rightLines}}" style="{{line.rowStyle}}">
            <text class="result-equation-side" style="{{line.textStyle}}">{{line.text}}</text>
          </div>
          <div class="result-meta-row" for="{{meta in $item.metaLineRows}}" style="{{meta.rowStyle}}">
            <text class="result-meta-text" style="{{meta.staticStyle}}">{{meta.text}}</text>
          </div>
        </div>
      </list-item>
    </list>
    <text class="results-empty" if="{{!searchResults.length}}" style="left: {{queryLeft}}px;width: {{queryWidth}}px;">{{emptyMessage}}</text>
    <div class="results-header" style="width: {{screenWidth}}px;height: {{headerHeight}}px;">
      <text class="results-back" style="left: {{topButtonLeft}}px;width: {{topButtonWidth}}px;" @click="goBack">返回</text>
      <text class="results-title" style="left: {{titleLeft}}px;width: {{titleWidth}}px;">查询结果</text>
      <text class="results-query" style="left: {{queryLeft}}px;width: {{queryWidth}}px;">{{searchFormula1Display}} + {{searchFormula2Display}}</text>
    </div>
    <div class="results-pagination" if="{{totalPages > 1}}" style="left: {{paginationLeft + paginationDragOffset}}px;width: {{paginationWidth}}px;bottom: {{bottomSafe}}px;">
      <div class="page-button {{currentPage <= 0 ? 'page-button-disabled' : ''}}" style="width: {{pageButtonWidth}}px;" @click="prevPage">
        <text class="page-button-text">上一页</text>
      </div>
      <text class="page-indicator-text" style="width: {{pageIndicatorWidth}}px;">{{currentPage + 1}} / {{totalPages}}</text>
      <div class="page-button {{currentPage >= totalPages - 1 ? 'page-button-disabled' : ''}}" style="width: {{pageButtonWidth}}px;" @click="nextPage">
        <text class="page-button-text">下一页</text>
      </div>
    </div>
  </div>
</template>

<script>
import storage from "@system.storage"
import router from "@system.router"
import device from "@system.device"
import { searchReactionsByPair } from "../../services/chemSearch.js"
import { applyResponsiveLayout } from "../../services/deviceLayout.js"
import { formatEquationSideText, formatInputFormula } from "../../services/formulaFormat.js"

const STORAGE_KEY_SEARCH_LEFT = "CHEMISTRY_TOOLBOX_SEARCH_LEFT"
const STORAGE_KEY_SEARCH_RIGHT = "CHEMISTRY_TOOLBOX_SEARCH_RIGHT"
const RESULTS_PER_PAGE = 4
const SWIPE_DISTANCE = 72
const PAGINATION_DRAG_LIMIT = 24
const PAGINATION_DRAG_ZONE_HEIGHT = 84
const BASE_CARD_WIDTH = 188
const CARD_BOTTOM_GAP = 10
const MIN_CARD_HEIGHT = 116
const META_ROW_GAP = 4

function clamp(value, min, max) {
  return Math.max(min, Math.min(max, value))
}

function estimateTextWidth(text, fontSize) {
  const value = text || ""
  let width = 0
  for (let i = 0; i < value.length; i += 1) {
    const char = value[i]
    const code = value.charCodeAt(i)
    if (char === " ") {
      width += fontSize * 0.42
    } else if (char === "+" || char === "-" || char === "/" || char === "." || char === "·") {
      width += fontSize * 0.72
    } else if (char === "(" || char === ")" || char === "[" || char === "]") {
      width += fontSize * 0.62
    } else if (code >= 0x2070 && code <= 0x209F) {
      width += fontSize * 0.62
    } else if (code > 0x2E80) {
      width += fontSize
    } else if (char >= "A" && char <= "Z") {
      width += fontSize * 0.92
    } else if (char >= "a" && char <= "z") {
      width += fontSize * 0.72
    } else if (char >= "0" && char <= "9") {
      width += fontSize * 0.66
    } else {
      width += fontSize * 0.82
    }
  }
  return Math.max(32, Math.ceil(width + fontSize))
}

function wrapTextLinesToWidth(text, width, fontSize) {
  const value = text || ""
  if (!value) {
    return [""]
  }
  const lines = []
  let line = ""
  const maxWidth = Math.max(1, width - fontSize)
  for (let i = 0; i < value.length; i += 1) {
    const char = value[i]
    const candidate = line + char
    if (line && estimateTextWidth(candidate, fontSize) > maxWidth) {
      lines.push(line.replace(/\s+$/g, ""))
      line = char.replace(/^\s+/g, "")
    } else {
      line = candidate
    }
  }
  if (line) {
    lines.push(line.replace(/\s+$/g, ""))
  }
  return lines.length > 0 ? lines : [""]
}

function px(value) {
  return Math.round(value || 0) + "px"
}

function styleFrom(parts) {
  return parts.join(";") + ";"
}

function buildSingleLineTextStyle(width, fontSize, lineHeight) {
  return styleFrom([
    "width: " + px(width),
    "height: " + px(lineHeight),
    "font-size: " + px(fontSize),
    "line-height: " + px(lineHeight),
    "lines: 1"
  ])
}

function buildTextLineRows(lines, width, fontSize, lineHeight, gapAfterLast) {
  const rows = []
  for (let i = 0; i < lines.length; i += 1) {
    const rowHeight = lineHeight + (i === lines.length - 1 ? gapAfterLast : 0)
    rows.push({
      text: lines[i],
      rowHeight,
      rowStyle: styleFrom([
        "height: " + px(rowHeight)
      ]),
      textStyle: buildSingleLineTextStyle(width, fontSize, lineHeight),
      staticStyle: buildSingleLineTextStyle(width, fontSize, lineHeight)
    })
  }
  return rows
}

function measureEquationText(text, metrics) {
  const textWidth = metrics.cardWidth - metrics.cardPaddingX * 2
  const lines = wrapTextLinesToWidth(text, textWidth, metrics.sideFontSize)
  return {
    lines: buildTextLineRows(lines, textWidth, metrics.sideFontSize, metrics.sideLineHeight, 0),
    textHeight: lines.length * metrics.sideLineHeight,
    marquee: false
  }
}

function measureMetaRow(id, label, value, metrics) {
  if (!value) {
    return null
  }
  const text = label + "：" + value
  const textWidth = metrics.cardWidth - metrics.cardPaddingX * 2
  const lines = wrapTextLinesToWidth(text, textWidth, metrics.metaFontSize)
  const lineRows = buildTextLineRows(lines, textWidth, metrics.metaFontSize, metrics.metaLineHeight, META_ROW_GAP)
  let rowHeight = 0
  for (let i = 0; i < lineRows.length; i += 1) {
    rowHeight += lineRows[i].rowHeight
  }
  return {
    id,
    lineRows,
    value,
    textHeight: lines.length * metrics.metaLineHeight,
    rowHeight,
    marquee: false,
    rowStyle: styleFrom(["height: " + px(rowHeight)])
  }
}

function buildMetaRows(item, metrics) {
  const rows = [
    measureMetaRow("type", "类型", item.type, metrics),
    measureMetaRow("conditions", "条件", item.conditions, metrics),
    measureMetaRow("phenomenon", "现象", item.phenomenon, metrics)
  ]
  const result = []
  for (let i = 0; i < rows.length; i += 1) {
    if (rows[i]) {
      result.push(rows[i])
    }
  }
  return result
}

function flattenMetaRows(metaRows) {
  const result = []
  for (let i = 0; i < metaRows.length; i += 1) {
    const row = metaRows[i]
    for (let j = 0; j < row.lineRows.length; j += 1) {
      const lineRow = row.lineRows[j]
      result.push({
        id: row.id + "-" + j,
        text: lineRow.text,
        rowHeight: lineRow.rowHeight,
        rowStyle: lineRow.rowStyle,
        staticStyle: lineRow.staticStyle
      })
    }
  }
  return result
}

function withMeasuredLayout(item, metrics) {
  const leftMeasure = measureEquationText(item.leftDisplay, metrics)
  const rightMeasure = measureEquationText(item.rightDisplay, metrics)
  const metaRows = buildMetaRows(item, metrics)
  const metaLineRows = flattenMetaRows(metaRows)
  const leftTextHeight = leftMeasure.textHeight
  const rightTextHeight = rightMeasure.textHeight
  let metaHeight = 0
  for (let i = 0; i < metaRows.length; i += 1) {
    metaHeight += metaRows[i].rowHeight
  }
  const cardHeight = Math.max(
    metrics.minCardHeight,
    metrics.cardPaddingY * 2 + leftTextHeight + metrics.arrowHeight + rightTextHeight + metaHeight
  )
  return Object.assign({}, item, {
    leftLines: leftMeasure.lines,
    rightLines: rightMeasure.lines,
    leftTextHeight,
    rightTextHeight,
    metaLineRows,
    cardHeight,
    itemHeight: cardHeight + CARD_BOTTOM_GAP,
    itemStyle: styleFrom(["height: " + px(cardHeight + CARD_BOTTOM_GAP)]),
    cardStyle: styleFrom([
      "height: " + px(cardHeight),
      "padding: " + px(metrics.cardPaddingY) + " " + px(metrics.cardPaddingX),
      "border-radius: " + px(metrics.cardRadius)
    ])
  })
}

export default {
  private: {
    searchFormula1: "",
    searchFormula2: "",
    searchFormula1Display: "",
    searchFormula2Display: "",
    rawSearchResults: [],
    searchResults: [],
    visibleResults: [],
    currentPage: 0,
    totalPages: 1,
    emptyMessage: "没有找到同时包含这两个分子式的方程式",
    screenWidth: 212,
    screenHeight: 520,
    screenShape: "pill",
    cardLeft: 12,
    cardWidth: 188,
    headerHeight: 124,
    topButtonLeft: 66,
    topButtonWidth: 80,
    titleLeft: 46,
    titleWidth: 120,
    queryLeft: 18,
    queryWidth: 176,
    paginationLeft: 12,
    paginationWidth: 240,
    paginationDragOffset: 0,
    pageButtonWidth: 74,
    pageIndicatorWidth: 92,
    bottomSafe: 10,
    resultsListTopPadding: 132,
    resultsListBottomPadding: 62,
    resultCardPaddingX: 12,
    resultCardPaddingY: 10,
    resultCardRadius: 18,
    resultTextWidth: 164,
    resultSideFontSize: 18,
    resultSideLineHeight: 26,
    resultArrowFontSize: 18,
    resultArrowLineHeight: 24,
    resultMetaFontSize: 14,
    resultMetaLineHeight: 22,
    resultMinCardHeight: 116,
    resultArrowHeight: 30
  },

  onInit() {
    this.touchStartX = null
    this.touchStartY = null
    this.isPaginationDragging = false
    this.paginationDragStartOffset = 0
    applyResponsiveLayout(this, device, "pill")
    this.loadSearchInputs()
  },

  applyScreenLayout(layout) {
    const isPill = layout.shape === "pill"
    const resultCardWidth = isPill
      ? layout.cardWidth
      : Math.max(layout.cardWidth, Math.floor(layout.screenWidth * (layout.shape === "round" ? 0.76 : 0.84)))
    const resultScale = isPill ? 1 : resultCardWidth / BASE_CARD_WIDTH
    this.screenWidth = layout.screenWidth
    this.screenHeight = layout.screenHeight
    this.screenShape = layout.shape
    this.cardLeft = Math.floor((layout.screenWidth - resultCardWidth) / 2)
    this.cardWidth = resultCardWidth
    this.headerHeight = layout.headerHeight
    this.topButtonLeft = layout.topButtonLeft
    this.topButtonWidth = layout.topButtonWidth
    this.titleLeft = layout.titleLeft
    this.titleWidth = layout.titleWidth
    this.queryLeft = layout.queryLeft
    this.queryWidth = layout.queryWidth
    this.paginationLeft = layout.paginationLeft
    this.paginationWidth = layout.paginationWidth
    if (!isPill) {
      this.paginationDragOffset = 0
    }
    this.pageButtonWidth = layout.pageButtonWidth
    this.pageIndicatorWidth = layout.pageIndicatorWidth
    this.bottomSafe = layout.bottomSafe
    this.resultsListTopPadding = layout.resultsListTopPadding
    this.resultsListBottomPadding = 52 + layout.bottomSafe
    this.resultCardPaddingX = Math.floor(12 * resultScale)
    this.resultCardPaddingY = Math.floor(10 * resultScale)
    this.resultCardRadius = Math.floor(18 * resultScale)
    this.resultTextWidth = resultCardWidth - this.resultCardPaddingX * 2
    this.resultSideFontSize = Math.floor(18 * resultScale)
    this.resultSideLineHeight = Math.floor(26 * resultScale)
    this.resultArrowFontSize = Math.floor(18 * resultScale)
    this.resultArrowLineHeight = Math.floor(24 * resultScale)
    this.resultMetaFontSize = Math.floor(14 * resultScale)
    this.resultMetaLineHeight = Math.floor(22 * resultScale)
    this.resultMinCardHeight = Math.floor(MIN_CARD_HEIGHT * resultScale)
    this.resultArrowHeight = Math.floor(30 * resultScale)
    if (this.rawSearchResults.length > 0) {
      this.rebuildMeasuredResults()
    }
  },

  loadSearchInputs() {
    storage.get({
      key: STORAGE_KEY_SEARCH_LEFT,
      success: (left) => {
        const formula1 = left || ""
        storage.get({
          key: STORAGE_KEY_SEARCH_RIGHT,
          success: (right) => {
            const formula2 = right || ""
            this.applySearch(formula1, formula2)
          },
          fail: () => {
            this.applySearch(formula1, "")
          }
        })
      },
      fail: () => {
        this.applySearch("", "")
      }
    })
  },

  applySearch(formula1, formula2) {
    this.searchFormula1 = formula1
    this.searchFormula2 = formula2
    this.searchFormula1Display = formatInputFormula(formula1)
    this.searchFormula2Display = formatInputFormula(formula2)

    if (!formula1 || !formula2) {
      this.rawSearchResults = []
      this.searchResults = []
      this.visibleResults = []
      this.currentPage = 0
      this.totalPages = 1
      this.emptyMessage = "没有查询参数，请返回主页重新搜索"
      return
    }

    this.rawSearchResults = searchReactionsByPair(formula1, formula2)
    this.rebuildMeasuredResults()
    this.currentPage = 0
    this.totalPages = Math.max(1, Math.ceil(this.searchResults.length / RESULTS_PER_PAGE))
    this.updateVisibleResults()
    this.emptyMessage = "没有找到同时包含这两个分子式的方程式"
  },

  rebuildMeasuredResults() {
    const metrics = {
      cardWidth: this.cardWidth,
      cardPaddingX: this.resultCardPaddingX,
      cardPaddingY: this.resultCardPaddingY,
      screenWidth: this.screenWidth,
      screenShape: this.screenShape,
      sideFontSize: this.resultSideFontSize,
      sideLineHeight: this.resultSideLineHeight,
      arrowHeight: this.resultArrowHeight,
      metaFontSize: this.resultMetaFontSize,
      metaLineHeight: this.resultMetaLineHeight,
      minCardHeight: this.resultMinCardHeight,
      cardRadius: this.resultCardRadius,
      textWidth: this.resultTextWidth
    }
    this.searchResults = this.rawSearchResults.map((item) => {
      const equation = item.equation || ""
      const parts = equation.split("->")
      const left = (parts[0] || "").trim()
      const right = (parts[1] || "").trim()
      return withMeasuredLayout({
        id: item.id,
        type: item.type || "",
        conditions: item.conditions || "",
        phenomenon: item.phenomenon || "",
        commonness: item.commonness || "",
        visibility: item.visibility || "",
        leftDisplay: formatEquationSideText(left),
        rightDisplay: formatEquationSideText(right)
      }, metrics)
    })
    this.totalPages = Math.max(1, Math.ceil(this.searchResults.length / RESULTS_PER_PAGE))
    this.updateVisibleResults()
  },

  updateVisibleResults() {
    const start = this.currentPage * RESULTS_PER_PAGE
    this.visibleResults = this.searchResults.slice(start, start + RESULTS_PER_PAGE)
  },

  scrollResultsToTop() {
    setTimeout(() => {
      if (this.$element("resultsList")) {
        this.$element("resultsList").scrollTo({
          top: 0,
          left: 0,
          behavior: "smooth"
        })
      }
    }, 0)
  },

  nextPage() {
    if (this.currentPage >= this.totalPages - 1) {
      return
    }
    this.currentPage += 1
    this.updateVisibleResults()
    this.scrollResultsToTop()
  },

  prevPage() {
    if (this.currentPage <= 0) {
      return
    }
    this.currentPage -= 1
    this.updateVisibleResults()
    this.scrollResultsToTop()
  },

  handleTouchStart(eve) {
    this.touchStartX = this.getPoint(eve, "x")
    this.touchStartY = this.getPoint(eve, "y")
    this.isPaginationDragging = this.isPillScreen() && this.isPaginationTouchArea(this.touchStartY) && this.totalPages > 1
    this.paginationDragStartOffset = this.paginationDragOffset
  },

  handleTouchMove(eve) {
    if (!this.isPaginationDragging || this.touchStartX === null) {
      return
    }
    const currentX = this.getPoint(eve, "x")
    if (currentX === null) {
      return
    }
    const deltaX = currentX - this.touchStartX
    this.paginationDragOffset = clamp(
      this.paginationDragStartOffset + deltaX,
      -PAGINATION_DRAG_LIMIT,
      PAGINATION_DRAG_LIMIT
    )
  },

  handleTouchEnd(eve) {
    const endX = this.getPoint(eve, "x")
    const endY = this.getPoint(eve, "y")
    if (this.touchStartX === null || endX === null) {
      return
    }

    const deltaX = endX - this.touchStartX
    const deltaY = (endY || 0) - (this.touchStartY || 0)
    const absX = Math.abs(deltaX)
    const absY = Math.abs(deltaY)
    if (this.isPaginationDragging) {
      this.isPaginationDragging = false
      this.touchStartX = null
      this.touchStartY = null
      return
    }

    if (absX >= SWIPE_DISTANCE && absX > absY) {
      if (deltaX <= -SWIPE_DISTANCE) {
        this.nextPage()
      } else if (deltaX >= SWIPE_DISTANCE) {
        this.prevPage()
      }
    }

    this.touchStartX = null
    this.touchStartY = null
  },

  isPillScreen() {
    return this.screenShape === "pill"
  },

  isPaginationTouchArea(y) {
    if (typeof y !== "number") {
      return false
    }
    return y >= this.screenHeight - this.bottomSafe - PAGINATION_DRAG_ZONE_HEIGHT
  },

  getPoint(eve, axis) {
    if (!eve) {
      return null
    }
    const point = (eve.touches && eve.touches[0]) || (eve.changedTouches && eve.changedTouches[0]) || eve
    const candidates = axis === "x"
      ? ["globalX", "screenX", "clientX", "pageX", "x"]
      : ["globalY", "screenY", "clientY", "pageY", "y"]
    for (let i = 0; i < candidates.length; i += 1) {
      const key = candidates[i]
      if (typeof point[key] === "number") {
        return point[key]
      }
    }
    return null
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #f4f7f5;
}

.results-header {
  position: absolute;
  left: 0px;
  top: 0px;
  background-color: #f4f7f5;
}

.results-back {
  position: absolute;
  left: 128px;
  top: 8px;
  width: 80px;
  height: 44px;
  font-size: 20px;
  line-height: 44px;
  color: #ffffff;
  text-align: center;
  font-weight: bold;
  border-radius: 22px;
  background-color: #1e9b6c;
  border: 2px solid #157d58;
}

.results-title {
  position: absolute;
  left: 78px;
  top: 54px;
  width: 180px;
  font-size: 28px;
  line-height: 34px;
  color: #16231f;
  text-align: center;
  font-weight: bold;
}

.results-query {
  position: absolute;
  left: 18px;
  top: 86px;
  width: 300px;
  font-size: 19px;
  line-height: 24px;
  color: #244238;
  text-align: center;
  font-weight: bold;
  lines: 1;
  text-overflow: ellipsis;
}

.results-subtitle {
  width: 100%;
  padding: 0 8px;
  font-size: 18px;
  line-height: 24px;
  color: #6a7b74;
  text-align: center;
}

.results-empty {
  position: absolute;
  left: 18px;
  top: 180px;
  width: 300px;
  font-size: 20px;
  line-height: 28px;
  color: #6a7b74;
  text-align: center;
}

.results-listview {
  position: absolute;
  top: 0px;
}

.results-tip-item {
  width: 100%;
  height: 34px;
  justify-content: center;
}

.result-card-item {
  width: 100%;
  padding-bottom: 10px;
}

.result-card {
  width: 100%;
  padding: 10px 12px;
  border-radius: 18px;
  background-color: #e3eee9;
  border: 2px solid #c7d9d1;
  flex-direction: column;
}

.result-equation-arrow {
  margin-top: 3px;
  margin-bottom: 3px;
  font-size: 18px;
  line-height: 24px;
  color: #4f5f59;
  text-align: center;
}

.result-equation-side {
  width: 100%;
  font-size: 18px;
  line-height: 26px;
  color: #182b25;
  font-weight: bold;
  text-align: center;
  text-overflow: clip;
}

.result-equation-marquee {
  position: relative;
  width: 100%;
  height: 26px;
  overflow: hidden;
}

.result-marquee-track {
  position: absolute;
  top: 0px;
  height: 26px;
}

.result-equation-marquee-text {
  position: absolute;
  top: 0px;
  font-size: 18px;
  line-height: 26px;
  color: #182b25;
  font-weight: bold;
  text-align: left;
  lines: 1;
  text-overflow: clip;
}

.result-meta-row {
  width: 100%;
}

.result-meta-text {
  width: 100%;
  font-size: 14px;
  line-height: 22px;
  color: #4f5f59;
  text-overflow: clip;
}

.result-meta-label {
  position: absolute;
  left: 0px;
  top: 0px;
  font-size: 14px;
  line-height: 22px;
  color: #4f5f59;
}

.result-meta-marquee {
  position: absolute;
  width: 100%;
  height: 22px;
  overflow: hidden;
  color: #4f5f59;
}

.result-meta-marquee-text {
  position: absolute;
  top: 0px;
  font-size: 14px;
  line-height: 22px;
  color: #4f5f59;
  text-align: left;
  lines: 1;
  text-overflow: clip;
}

.results-pagination {
  position: absolute;
  left: 48px;
  bottom: 8px;
  width: 240px;
  height: 44px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.page-button {
  width: 74px;
  height: 44px;
  border-radius: 22px;
  background-color: #1e9b6c;
  justify-content: center;
  align-items: center;
}

.page-button-disabled {
  background-color: #b7c9c1;
}

.page-button-text {
  font-size: 16px;
  line-height: 20px;
  color: #ffffff;
  text-align: center;
}

.page-indicator-text {
  width: 92px;
  font-size: 18px;
  line-height: 22px;
  color: #4f5f59;
  text-align: center;
  font-weight: bold;
}
</style>
