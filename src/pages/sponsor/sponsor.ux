<template>
  <div class="sponsor-page">
    <text class="sponsor-back" style="left: {{topButtonLeft}}px;width: {{topButtonWidth}}px;" @click="goBack">返回</text>
    <div class="sponsor-code-wrap" style="left: {{qrLeft}}px;top: {{qrTop}}px;width: {{qrSize}}px;height: {{qrSize}}px;">
      <img class="sponsor-code" style="width: {{qrImageSize}}px;height: {{qrImageSize}}px;" src="/common/sponsor-code.png" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import device from "@system.device"
import { applyResponsiveLayout } from "../../services/deviceLayout.js"

export default {
  private: {
    screenWidth: 212,
    screenHeight: 520,
    topButtonLeft: 66,
    topButtonWidth: 80,
    qrLeft: 16,
    qrTop: 165,
    qrSize: 180,
    qrImageSize: 170
  },

  onInit() {
    applyResponsiveLayout(this, device, "pill")
  },

  applyScreenLayout(layout) {
    this.screenWidth = layout.screenWidth
    this.screenHeight = layout.screenHeight
    this.topButtonLeft = layout.topButtonLeft
    this.topButtonWidth = layout.topButtonWidth
    this.qrSize = layout.qrSize
    this.qrImageSize = Math.max(120, layout.qrSize - 10)
    this.qrLeft = layout.qrLeft
    this.qrTop = layout.qrTop
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.sponsor-page {
  width: 100%;
  height: 100%;
  background-color: #f4f7f5;
}

.sponsor-back {
  position: absolute;
  top: 18px;
  height: 44px;
  color: #ffffff;
  font-size: 20px;
  line-height: 44px;
  text-align: center;
  font-weight: bold;
  border-radius: 22px;
  background-color: #1e9b6c;
  border: 2px solid #157d58;
}

.sponsor-code-wrap {
  position: absolute;
  border-radius: 18px;
  background-color: #ffffff;
  align-items: center;
  justify-content: center;
}

.sponsor-code {
  object-fit: contain;
}
</style>
