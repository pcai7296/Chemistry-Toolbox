<script>
import router from "@system.router"
import device from "@system.device"
import { applyResponsiveLayout } from "../../services/deviceLayout.js"
import {
  APP_VERSION,
  DEVELOPER_NAME,
  PROJECT_REPO,
  PROJECT_URL
} from "../../common/appInfo.js"

export default {
  private: {
    appVersion: APP_VERSION,
    developerName: DEVELOPER_NAME,
    projectRepo: PROJECT_REPO,
    projectUrl: PROJECT_URL,
    screenWidth: 212,
    screenHeight: 520,
    topButtonLeft: 66,
    topButtonWidth: 80,
    cardLeft: 16,
    cardWidth: 180,
    noteWidth: 164,
    aboutInfoTop: 270
  },

  onInit() {
    applyResponsiveLayout(this, device, "pill")
  },

  applyScreenLayout(layout) {
    this.screenWidth = layout.screenWidth
    this.screenHeight = layout.screenHeight
    this.topButtonLeft = layout.topButtonLeft
    this.topButtonWidth = layout.topButtonWidth
    this.cardLeft = layout.cardLeft
    this.cardWidth = layout.cardWidth
    this.noteWidth = Math.max(140, layout.cardWidth - 16)
    this.aboutInfoTop = layout.aboutInfoTop
  },

  goBack() {
    router.back()
  }
}
</script>

